### Base settings
@baseUrl = http://localhost:8081
@today = {{$datetime "2025-09-15"}}
@actor = system

### 0. Health check
GET {{baseUrl}}/health

###
# 1) 제품 생성(Product) - FG, RM, SG 샘플
# 참고: productCode는 유니크. 중복 시 409 아니고 500/400 날 수 있으니 다른 코드로 바꿔서 시도.
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "productCode": "FG-TEST-001",
  "name": "완제품-테스트-001",
  "type": "FG",
  "unit": "EA",
  "description": "테스트 완제품"
}

> {% client.global.set("fgId", response.body.id); %}

###
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "productCode": "SG-TEST-001",
  "name": "서브어셈블리-테스트-001",
  "type": "SG",
  "unit": "EA",
  "description": "테스트 서브어셈블리"
}

> {% client.global.set("sgId", response.body.id); %}

###
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "productCode": "RM-TEST-001",
  "name": "자재-테스트-001",
  "type": "RM",
  "unit": "EA",
  "description": "테스트 자재"
}

> {% client.global.set("rmId", response.body.id); %}

###
# 2) 표준단가 등록(MaterialCost) - RM/SG/FG 각각 1건씩
# MaterialCostUpsertRequest: productId, stdCost, effectiveFrom, effectiveTo(optional)
# rm,sg,fg

POST {{baseUrl}}/api/material-costs
Content-Type: application/json

{
  "productId": "b574ba2e-92a5-44f9-b0f1-251c8130c101",
  "stdCost": 1200.000000,
  "effectiveFrom": "{{today}}"
}

###
POST {{baseUrl}}/api/material-costs
Content-Type: application/json

{
  "productId": "ad2d8cd9-72d7-4d46-a5d3-192c590ef640",
  "stdCost": 35000.000000,
  "effectiveFrom": "{{today}}"
}

###
POST {{baseUrl}}/api/material-costs
Content-Type: application/json

{
  "productId": "5d53766a-5e8b-4c2e-ad61-11125db05419",
  "stdCost": 90000.000000,
  "effectiveFrom": "{{today}}"
}

###
# 3) BOM 헤더 생성 (FG 대상, 활성 + 유효기간 from=오늘)
POST {{baseUrl}}/api/boms?productId=5d53766a-5e8b-4c2e-ad61-11125db05419&revision=R1&active=true&effectiveFrom={{today}}
Accept: application/json

> {% client.global.set("bomId", response.body.id); %}

###
# 4) BOM 라인 추가 (FG 하위에 SG, RM 추가)
# POST /api/boms/lines  (body: BomLineCreateRequest)
POST {{baseUrl}}/api/boms/lines
Content-Type: application/json

{
  "bomId": "77e3c670-0a63-4759-9529-f2c4d24e8708",
  "parentLineId": null,
  "componentProductId": "ad2d8cd9-72d7-4d46-a5d3-192c590ef640",
  "qty": 1.000000,
  "scrapRate": 0.000000,
  "note": "SG 컴포넌트"
}

###
POST {{baseUrl}}/api/boms/lines
Content-Type: application/json

{
  "bomId": "77e3c670-0a63-4759-9529-f2c4d24e8708",
  "parentLineId": null,
  "componentProductId": "b574ba2e-92a5-44f9-b0f1-251c8130c101",
  "qty": 2.500000,
  "scrapRate": 0.020000,
  "note": "RM 컴포넌트"
}

###
# 5) BOM 라인 조회 - fetch join + DTO 응답
GET {{baseUrl}}/api/boms/77e3c670-0a63-4759-9529-f2c4d24e8708/lines
Accept: application/json

###
# 6) 생산계획 생성 (DRAFT → CONFIRMED 전이 테스트 대비 DRAFT로 만듦)
POST {{baseUrl}}/api/plans?planCode=PLAN-TEST-001&productId=5d53766a-5e8b-4c2e-ad61-11125db05419&qty=10.000000&startDate={{today}}&endDate={{today}}&status=DRAFT
Accept: application/json

> {% client.global.set("planId", response.body.id); %}

@planId = 8d063db4-2dc1-4981-9ad7-7eb498871c0f
###
# 7) 생산계획 상태 전이 (DRAFT -> CONFIRMED)
PATCH {{baseUrl}}/api/plans/{{planId}}/status?nextStatus=CONFIRMED&actor={{actor}}
Accept: application/json

###
# 8) 생산계획 상태 전이 (CONFIRMED -> IN_PRODUCTION)
PATCH {{baseUrl}}/api/plans/{{planId}}/status?nextStatus=IN_PRODUCTION&actor={{actor}}
Accept: application/json

###
# 9) 생산계획 기준 원가 계산 (by-plan)
GET {{baseUrl}}/api/costs/by-plan/{{planId}}?laborRate=0.100000&overheadRate=0.100000
Accept: application/json

###
# 10) 제품 기준 원가 계산 (by-product)
GET {{baseUrl}}/api/costs/by-product/5d53766a-5e8b-4c2e-ad61-11125db05419?qty=5.000000&laborRate=0.100000&overheadRate=0.100000&baseDate={{today}}
Accept: application/json


@fgId = 5d53766a-5e8b-4c2e-ad61-11125db05419
### Preview by-product (no save)
GET {{baseUrl}}/api/costs/by-product/{{fgId}}?qty=5.000000&laborRate=0.100000&overheadRate=0.100000&baseDate={{today}}
Accept: application/json

### Save by-product
POST {{baseUrl}}/api/costs/snapshots/by-product
Content-Type: application/json

{
  "productId": "{{fgId}}",
  "qty": 5.000000,
  "laborRate": 0.100000,
  "overheadRate": 0.100000,
  "baseDate": "{{today}}",
  "note": "옵션C 저장 테스트"
}

### Preview by-plan (no save)
GET {{baseUrl}}/api/costs/by-plan/{{planId}}?laborRate=0.100000&overheadRate=0.100000
Accept: application/json

### Save by-plan
POST {{baseUrl}}/api/costs/snapshots/by-plan
Content-Type: application/json

{
  "planId": "{{planId}}",
  "laborRate": 0.100000,
  "overheadRate": 0.100000,
  "note": "옵션C 저장 테스트"
}