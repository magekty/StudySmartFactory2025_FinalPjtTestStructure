# test/erp-be.http
@host = http://localhost:8081
@apiKey = change-me-demo-key

### health
GET {{host}}/actuator/health

### create work order (idempotent)
POST {{host}}/erp/work-orders
X-API-Key: {{apiKey}}
X-Idempotency-Key: 11111111-1111-1111-1111-111111111111
Content-Type: application/json

{
  "workOrderId": "WO-123",
  "workOrderNumber": "WO-2025-0001",
  "itemId": "I-0001",
  "qty": 100,
  "status": "P",
  "startTs": "2025-08-20T06:00:00Z"
}

### change status (idempotent)
PUT {{host}}/erp/work-orders/WO-123/status
X-API-Key: {{apiKey}}
X-Idempotency-Key: 22222222-2222-2222-2222-222222222222
Content-Type: application/json

{
  "status": "R",
  "changedAt": "2025-08-20T07:00:00Z"
}

### performance (idempotent)
POST {{host}}/erp/performances
X-API-Key: {{apiKey}}
X-Idempotency-Key: 33333333-3333-3333-3333-333333333333
Content-Type: application/json

{
  "workOrderId": "WO-123",
  "itemId": "I-0001",
  "processId": "P-0001",
  "equipmentId": "E-0001",
  "goodQty": 98,
  "defectQty": 2,
  "startTime": "2025-08-20T07:00:00Z",
  "endTime": "2025-08-20T07:30:00Z"
}

### backflush (shadow accepted)
POST {{host}}/erp/consumptions/backflush
X-API-Key: {{apiKey}}
X-Idempotency-Key: 44444444-4444-4444-4444-444444444444
Content-Type: application/json

{
  "workOrderId": "WO-123",
  "lines": [
    { "componentId": "RM-001", "qty": 98.0, "uom": "EA" },
    { "componentId": "RM-002", "qty": 49.0, "uom": "EA" }
  ]
}

## 증분 테스트
### ERP health테스트
GET {{host}}/actuator/health
### Items 전체
GET {{host}}/items
X-API-Key: {{apiKey}}

### Items 증분
GET {{host}}/items?updatedSince=2025-08-29T09:00:00Z
X-API-Key: {{apiKey}}

### BOM 전체
GET {{host}}/boms
X-API-Key: {{apiKey}}

### BOM 증분
GET {{host}}/boms?updatedSince=2025-08-29T09:00:00Z
X-API-Key: {{apiKey}}

### Plan 신규
POST {{host}}/plans
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "planId":"PL-0001","planLineNo":1,"itemId":"I-0001",
  "qty":100,"dueDateUtc":"2025-09-01T00:00:00Z",
  "priority":1,"isDeleted":false
}

### Plan 수정
PUT {{host}}/plans
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "planId":"PL-0001","planLineNo":1,"itemId":"I-0001",
  "qty":120,"dueDateUtc":"2025-09-02T00:00:00Z",
  "priority":2,"isDeleted":false
}

### Plan tombstone
PUT {{host}}/plans
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "planId":"PL-0001","planLineNo":1,"itemId":"I-0001",
  "qty":0,"dueDateUtc":"2025-09-02T00:00:00Z",
  "priority":2,"isDeleted":true
}

### TIME_ORDER_INVALID 유도 (end < start)
POST {{host}}/erp/performances
X-API-Key: {{apiKey}}
X-Idempotency-Key: 99999999-9999-9999-9999-999999999999
Content-Type: application/json

{
  "workOrderId": "WO-TIME-TEST",
  "itemId": "I-0001",
  "processId": "P-0001",
  "equipmentId": "E-0001",
  "goodQty": 1,
  "defectQty": 0,
  "startTime": "2025-09-01T09:30:00Z",
  "endTime":   "2025-09-01T09:00:00Z"  // start보다 과거
}

### plans 신규
POST {{host}}/plans
X-API-Key: {{apiKey}}
Content-Type: application/json

{ "planId":"PL-0001","planLineNo":1,"itemId":"I-0001", "qty":100,"dueDateUtc":"2025-09-02T00:00:00Z", "priority":1,"unit":"EA","isDeleted":false }

### plans 수정
PUT {{host}}/plans
X-API-Key: {{apiKey}}
Content-Type: application/json

{ "planId":"PL-0001","planLineNo":1,"itemId":"I-0001", "qty":130,"dueDateUtc":"2025-09-04T00:00:00Z", "priority":2,"unit":"BOX","isDeleted":false }

### plans 삭제
PUT {{host}}/plans
X-API-Key: {{apiKey}}
Content-Type: application/json

{ "planId":"PL-0001","planLineNo":1,"itemId":"I-0001", "qty":0,"dueDateUtc":"2025-09-03T00:00:00Z", "priority":2,"unit":"BOX","isDeleted":true }

@host = http://localhost:8081/mock
@apiKey = change-me-demo-key


### items 시드 확인
GET  {{host}}/items
X-API-Key: {{apiKey}}
Content-Type: application/json

### boms 시드 확인
GET  {{host}}/boms
X-API-Key: {{apiKey}}
Content-Type: application/json

### items 시드 POST 확인
POST {{host}}/dev/items/seed
X-API-Key: {{apiKey}}
Content-Type: application/json

### boms 시드 POST 확인
POST {{host}}/dev/boms/seed
X-API-Key: {{apiKey}}
Content-Type: application/json

### boms deletes 카운트 증가 확인
POST {{host}}/dev/boms/delete-header?bomId=BOM-ITEM-100|A
X-API-Key: {{apiKey}}
Content-Type: application/json

### boms deletes 카운트 증가 확인
POST {{host}}/dev/boms/set-line-component?bomId=BOM-ITEM-200|A\&lineNo=1\&componentId=DOES\_NOT\_EXIST
X-API-Key: {{apiKey}}
### boms deletes 카운트 증가 확인
POST {{host}}/dev/boms/seed-bulk?count=30
X-API-Key: {{apiKey}}
