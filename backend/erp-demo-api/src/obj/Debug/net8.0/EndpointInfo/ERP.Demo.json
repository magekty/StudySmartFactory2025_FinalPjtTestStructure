          },
          "qty": {
            "type": "number",
            "format": "double"
          },
          "uom": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PerformanceCreateDto": {
        "type": "object",
        "properties": {
          "workOrderId": {
            "type": "string",
            "nullable": true
          },
          "itemId": {
            "type": "string",
            "nullable": true
          },
          "processId": {
            "type": "string",
            "nullable": true
          },
          "equipmentId": {
            "type": "string",
            "nullable": true
          },
          "goodQty": {
            "type": "number",
            "format": "double"
          },
          "defectQty": {
            "type": "number",
            "format": "double"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
