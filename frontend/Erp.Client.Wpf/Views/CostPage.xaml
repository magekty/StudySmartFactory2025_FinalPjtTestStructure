<Window x:Class="Erp.Client.Wpf.Views.CostPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:Erp.Client.Wpf.Utils"
        Title="원가 계산" Height="720" Width="1080">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12" utils:Spacing.HorizontalSpacing="8">
            <TextBlock Text="ProductId"/>
            <TextBox x:Name="txtProduct" Width="260"/>
            <TextBlock Text="PlanId" Margin="12,0,0,0"/>
            <TextBox x:Name="txtPlan" Width="260"/>
            <TextBlock Text="Qty" Margin="12,0,0,0"/>
            <TextBox x:Name="txtQty" Width="100" Text="1.000000"/>
            <TextBlock Text="Labor" Margin="12,0,0,0"/>
            <TextBox x:Name="txtLabor" Width="100" Text="0.100000"/>
            <TextBlock Text="OH" Margin="12,0,0,0"/>
            <TextBox x:Name="txtOh" Width="100" Text="0.100000"/>
            <Button x:Name="btnByProduct" Content="By Product" Width="120" Margin="12,0,0,0"/>
            <Button x:Name="btnByPlan" Content="By Plan" Width="120" Margin="8,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding Details}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}"/>
                <DataGridTextColumn Header="Code" Binding="{Binding ComponentCode}"/>
                <DataGridTextColumn Header="Name" Binding="{Binding ComponentName}"/>
                <DataGridTextColumn Header="BaseQty" Binding="{Binding BaseQty}"/>
                <DataGridTextColumn Header="ExplodedQty" Binding="{Binding ExplodedQty}"/>
                <DataGridTextColumn Header="UnitCost" Binding="{Binding UnitCost}"/>
                <DataGridTextColumn Header="MaterialCost" Binding="{Binding MaterialCost}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>