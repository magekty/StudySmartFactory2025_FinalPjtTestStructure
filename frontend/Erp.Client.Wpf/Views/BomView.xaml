<!-- Views/BomView.xaml (상단 조회 제거본: 트리/그리드/하단 라인 추가만 유지) -->
<UserControl x:Class="Erp.Client.Wpf.Views.BomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="800">
    <UserControl.Resources>
        <!-- 검증 스타일 등 기존 리소스 유지 -->
        <Style x:Key="ValidatedTextBox" TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True">
                            <Border Width="14" Height="14" Background="Transparent" Margin="4,0,0,0" DockPanel.Dock="Right">
                                <Path Data="M12,0 L24,24 0,24 z" Fill="#FFE57373" Stretch="Uniform"/>
                            </Border>
                            <Border BorderBrush="#FFE57373" BorderThickness="1" CornerRadius="3">
                                <AdornedElementPlaceholder/>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 상단 조회 제거: 첫 행 Auto 삭제 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="조회" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="12">
                <TextBlock Text="BOM ID *" Foreground="IndianRed" VerticalAlignment="Center"/>
                <TextBox Width="360" Margin="8,0,0,0" Text="{Binding QueryBomId, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" Style="{StaticResource ValidatedTextBox}"/>
                <Button Content="조회" Width="100" Margin="12,0,0,0" Command="{Binding QueryCommand}"/>
            </StackPanel>
        </GroupBox>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- 트리 (좌측) -->
            <TreeView x:Name="tvBom"
                  Grid.Row="0"
                  ItemsSource="{Binding Tree}"
                  SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1} (Qty={2:0.######}, Scrap={3:0.######})">
                                    <Binding Path="ComponentCode"/>
                                    <Binding Path="ComponentName"/>
                                    <Binding Path="Qty"/>
                                    <Binding Path="ScrapRate"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>

                <!--<TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
                                    <MenuItem Header="이 라인 삭제"
          Command="{Binding Path=DataContext.DeleteNodeCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}"
          CommandParameter="{Binding Path=DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>-->
            </TreeView>

            <!-- 그리드 (우측) -->
            <DataGrid Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  ColumnWidth="*"
                  HeadersVisibility="All"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="LineId" Binding="{Binding BomLineId}" Width="0*" MinWidth="0" Visibility="Hidden"/>
                    <DataGridTextColumn Header="Parent" Binding="{Binding ParentLineId}" Width="0" MinWidth="0" Visibility="Hidden"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding ComponentCode}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding ComponentName}" Width="2*" MinWidth="220"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="SizeToCells" MinWidth="100"/>
                    <DataGridTextColumn Header="Scrap" Binding="{Binding ScrapRate}" Width="SizeToCells" MinWidth="100"/>
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*" MinWidth="220"/>
                    <DataGridTemplateColumn Header="Action" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="삭제" Padding="6,2"
                          Command="{Binding DataContext.DeleteLineCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                          CommandParameter="{Binding .}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!-- 하단 라인 추가 -->
        <GroupBox Header="라인 추가" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- BOM ID -->
                <TextBlock Grid.Column="0" Visibility="Collapsed" Text="BOM ID *" Foreground="IndianRed" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Visibility="Hidden" Style="{StaticResource ValidatedTextBox}" IsReadOnly="True"
                 Text="{Binding AddBomId, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                <!-- Parent Line -->
                <TextBlock Grid.Column="3" Visibility="Collapsed" Text="ParentLineId" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" Visibility="Hidden" IsReadOnly="True" Text="{Binding AddParentLineId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 자재 선택(다중) -->
                <TextBlock Grid.Column="6" Text="라인 추가 자재 선택" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <TextBox Width="0" Visibility="Hidden" IsReadOnly="True" Text="{Binding SelectedProductName}" Margin="0,0,8,0"/>
                    <Button Content="추가 자재 검색" Width="100" Command="{Binding OpenMultiSelectDialogCommand}"/>
                </StackPanel>

                <!-- Qty -->
                <TextBlock Grid.Column="9" Text="Qty *" Foreground="IndianRed" VerticalAlignment="Center"/>
                <TextBox Grid.Column="10" Style="{StaticResource ValidatedTextBox}"
                 Text="{Binding AddQty, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                <!-- Scrap -->
                <TextBlock Grid.Column="12" Text="Scrap" VerticalAlignment="Center"/>
                <TextBox Grid.Column="13" Style="{StaticResource ValidatedTextBox}"
                 Text="{Binding AddScrapRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                <!-- Scrap -->
                <TextBlock Grid.Column="14" Text="Note" VerticalAlignment="Center"/>
                <TextBox Grid.Column="15" Style="{StaticResource ValidatedTextBox}"
                Text="{Binding AddNote, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                <!-- Note + 단일 추가 버튼 -->
                <!--<TextBlock Grid.Column="15" Text="Note" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="16" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Width="260" Text="{Binding AddNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <Button Content="추가(단일)" Width="100" Command="{Binding AddLineCommand}"/>
                </StackPanel>-->
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>