<UserControl x:Class="Erp.Client.Wpf.Views.ProductionPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="800">
	<Grid Margin="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="713*"/>
			<ColumnDefinition Width="463*"/>
		</Grid.ColumnDefinitions>

		<!-- 상단 필터/페이지 -->
		<DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
			<TextBox Width="220" Height="30" Margin="0,0,8,0"
					 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
					 ToolTip="계획코드/품목코드/명 검색"/>
			<ComboBox Width="140" Height="30" Margin="0,0,8,0"
					  ItemsSource="{Binding StatusOptions}"
					  SelectedItem="{Binding SelectedStatus}"
					  DisplayMemberPath="Label" SelectedValuePath="Value"/>
			<DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,8,0"/>
			<DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,8,0"/>
			<Button Content="검색" Height="30" Command="{Binding SearchCommand}"/>
			<TextBlock Text="{Binding PageInfo}" Margin="12,0,0,0" VerticalAlignment="Center"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
				<Button Content="◀" Width="36" Height="30" Margin="8,0,0,0"
						Command="{Binding PrevPageCommand}" />
				<Button Content="▶" Width="36" Height="30" Margin="4,0,0,0"
						Command="{Binding NextPageCommand}" />
			</StackPanel>
		</DockPanel>

		<!-- 좌: 목록 -->
		<DataGrid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
				  ItemsSource="{Binding Plans}"
				  SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
				  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
			<DataGrid.Columns>
				<DataGridTextColumn Header="계획코드" Binding="{Binding planCode}" Width="150"/>
				<DataGridTextColumn Header="품목코드" Binding="{Binding productCode}" Width="120"/>
				<DataGridTextColumn Header="품목명" Binding="{Binding productName}" Width="*"/>
				<DataGridTextColumn Header="시작" Binding="{Binding startDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="110"/>
				<DataGridTextColumn Header="종료" Binding="{Binding endDate, StringFormat=\{0:yyyy-MM-dd\}}" Width="110"/>
				<DataGridTextColumn Header="수량" Binding="{Binding qty}" Width="100"/>
				<DataGridTextColumn Header="상태" Binding="{Binding status}" Width="120"/>
			</DataGrid.Columns>
		</DataGrid>

		<!-- 우: 상세/액션 -->
		<Grid Grid.Row="1" Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="120"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Text="계획코드" VerticalAlignment="Center"/>
			<TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Detail.planCode, UpdateSourceTrigger=PropertyChanged}" />

			<TextBlock Grid.Row="1" Grid.Column="0" Text="품목ID" VerticalAlignment="Center"/>
			<TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Detail.productId, UpdateSourceTrigger=PropertyChanged}" />

			<TextBlock Grid.Row="2" Grid.Column="0" Text="기간" VerticalAlignment="Center"/>
			<StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
				<DatePicker SelectedDate="{Binding Detail.startDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
				<DatePicker SelectedDate="{Binding Detail.endDate, UpdateSourceTrigger=PropertyChanged}"/>
			</StackPanel>

			<TextBlock Grid.Row="3" Grid.Column="0" Text="수량" VerticalAlignment="Center"/>
			<TextBox   Grid.Row="3" Grid.Column="1"  Text="{Binding Detail.qty, UpdateSourceTrigger=PropertyChanged}" />

			<TextBlock Grid.Row="4" Grid.Column="0" Text="비고" VerticalAlignment="Center"/>
			<TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding Detail.note}" />

			<StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
						HorizontalAlignment="Right" Margin="0,10,0,0">
				<Button Content="신규" Width="80" Margin="0,0,8,0" Command="{Binding NewCommand}"/>
				<Button Content="생성" Width="80" Margin="0,0,8,0" Command="{Binding CreateCommand}"/>
				<Button Content="수정" Width="80" Margin="0,0,8,0" Command="{Binding UpdateCommand}"/>
				<Button Content="확정" Width="80" Margin="0,0,8,0" Command="{Binding ConfirmCommand}"/>
				<Button Content="취소" Width="80" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
				<Button Content="삭제" Width="80" Command="{Binding DeleteCommand}"/>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>