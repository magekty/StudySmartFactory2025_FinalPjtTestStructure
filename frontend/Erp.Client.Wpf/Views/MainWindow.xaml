<Window x:Class="Erp.Client.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:System="clr-namespace:System;assembly=mscorlib" 
        xmlns:views="clr-namespace:Erp.Client.Wpf.Views"
        Title="ERP WPF Client - Main" Height="780" Width="1400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 헤더 -->
        <Grid Background="#222" Height="48" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text=" ERP WPF Client" Foreground="White" FontSize="16"
                 VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <TabControl>
            
            <!-- 탭 1: 원가 계산 -->
            <TabItem Header="원가 계산">
                <ContentControl x:Name="costHost"/>
            </TabItem>
            
            <!-- 탭 2: BOM 관리 -->
            <TabItem Header="BOM 관리">
                <ContentControl x:Name="bomHost"/>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>