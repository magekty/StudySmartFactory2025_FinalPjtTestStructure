<Window x:Class="Erp.Client.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:System="clr-namespace:System;assembly=mscorlib"
        Title="ERP WPF Client - Main" Height="780" Width="1220"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 헤더 -->
        <Grid Background="#222" Height="48" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text=" ERP WPF Client" Foreground="White" FontSize="16"
                 VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1">
                <Button x:Name="btnOpenCostWindow" Content="원가 창" Margin="12,8,0,8" Padding="10,4"/>
                <Button x:Name="btnOpenBomWindow" Content="BOM 창" Margin="8,8,12,8" Padding="10,4"/>
            </StackPanel>
        </Grid>

        <TabControl>
            <!-- 탭 1: 원가 계산 -->
            <TabItem Header="원가 계산">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- by-product -->
                    <GroupBox Header="By Product" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <TextBlock Text="ProductId *" Foreground="IndianRed" VerticalAlignment="Center"/>
                            <TextBox x:Name="prod_ProductId" Width="320" Margin="8,0,0,0"/>
                            <TextBlock Text="Qty *" Foreground="IndianRed" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="prod_Qty" Width="120" Margin="8,0,0,0" Text="1.000000"/>
                            <TextBlock Text="Labor" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="prod_Labor" Width="100" Margin="8,0,0,0" Text="0.100000"/>
                            <TextBlock Text="OH" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="prod_Oh" Width="100" Margin="8,0,0,0" Text="0.100000"/>
                            <TextBlock Text="BaseDate" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <DatePicker x:Name="prod_BaseDate" Width="150" Margin="8,0,0,0" SelectedDate="{x:Static System:DateTime.Now}">
                                <DatePicker.Resources>
                                    <ResourceDictionary xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                                </DatePicker.Resources>
                            </DatePicker>
                            <Button x:Name="btnCalcByProduct" Content="계산" Width="100" Margin="16,0,0,0"/>
                            <Button x:Name="btnSaveByProduct" Content="저장(By Product)" Width="100" Margin="8,0,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- by-plan -->
                    <GroupBox Header="By Plan" Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel Margin="12">
                            <!-- A. PlanId 직접 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="PlanId" VerticalAlignment="Center"/>
                                <TextBox x:Name="plan_PlanId" Width="360" Margin="8,0,0,0"/>
                                <TextBlock Text="Labor" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="plan_Labor" Width="100" Margin="8,0,0,0" Text="0.100000"/>
                                <TextBlock Text="OH" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="plan_Oh" Width="100" Margin="8,0,0,0" Text="0.100000"/>
                                <Button x:Name="btnCalcByPlan" Content="계산(PlanId)" Width="100" Margin="16,0,0,0"/>
                                <Button x:Name="btnSaveByPlan" Content="저장(By Plan)" Width="100" Margin="8,0,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>

                    <!-- 결과 -->
                    <DataGrid Grid.Row="2" x:Name="gridCostDetails" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding ComponentCode}" Width="140"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding ComponentName}" Width="240"/>
                            <DataGridTextColumn Header="BaseQty" Binding="{Binding BaseQty}" Width="120"/>
                            <DataGridTextColumn Header="ExplodedQty" Binding="{Binding ExplodedQty}" Width="120"/>
                            <DataGridTextColumn Header="UnitCost" Binding="{Binding UnitCost}" Width="120"/>
                            <DataGridTextColumn Header="MaterialCost" Binding="{Binding MaterialCost}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 탭 2: BOM 관리 -->
            <TabItem Header="BOM 관리">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 조회 -->
                    <GroupBox Header="조회" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <TextBlock Text="조회 BOM ID *" Foreground="IndianRed" VerticalAlignment="Center"/>
                            <TextBox x:Name="bom_QueryBomId" Width="160" Margin="8,0,0,0"/>
                            <Button x:Name="btnBomQuery" Content="라인 조회" Width="120" Margin="16,0,0,0"/>
                            <Button x:Name="btnCopyQueryBomToAdd" Content="↓ 추가로 복사" Width="120" Margin="8,0,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 본문: 좌 트리 / 우 그리드 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="7*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 트리 -->
                        <TreeView x:Name="bom_Tree" Grid.Column="0" Margin="0,0,8,0" SelectedItemChanged="OnBomTreeSelected">
                            <!-- ItemTemplate는 코드비하인드에서 TreeNode 바인딩 또는 HierarchicalDataTemplate 구성 가능 -->
                        </TreeView>

                        <!-- 그리드 -->
                        <DataGrid x:Name="bom_Grid" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LineId" Binding="{Binding BomLineId}" Width="*"/>
                                <DataGridTextColumn Header="Parent" Binding="{Binding ParentLineId}" Width="140"/>
                                <DataGridTextColumn Header="ComponentId" Binding="{Binding ComponentProductId}" Width="*"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding ComponentCode}" Width="140"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding ComponentName}" Width="220"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="100"/>
                                <DataGridTextColumn Header="Scrap" Binding="{Binding ScrapRate}" Width="100"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 추가 -->
                    <GroupBox Header="라인 추가" Grid.Row="2" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="12">
                                <TextBlock Text="추가 BOM ID *" Foreground="IndianRed" VerticalAlignment="Center"/>
                                <TextBox x:Name="bom_AddBomId" Width="120" Margin="8,0,0,0"/>
                                <TextBlock Text="ParentLineId" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="bom_AddParent" Width="100" Margin="8,0,0,0"/>
                                <TextBlock Text="Component ProductId *" Foreground="IndianRed" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="bom_AddComp" Width="100" Margin="8,0,0,0"/>
                                <TextBlock Text="Qty *" Foreground="IndianRed" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="bom_AddQty" Width="60" Margin="8,0,0,0" Text="1.000000"/>
                                <TextBlock Text="Scrap" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="bom_AddScrap" Width="60" Margin="8,0,0,0" Text="0.000000"/>
                                <TextBlock Text="Note" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="bom_AddNote" Width="60" Margin="8,0,0,0"/>
                                <Button x:Name="btnBomAddNew" Content="추가" Width="60" Margin="16,0,0,0"/>
                                </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>