<UserControl x:Class="ERP.Frontend.Views.BomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ERP.Frontend.Views"
             xmlns:viewmodels="clr-namespace:ERP.Frontend.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:BomViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="BOM 관리" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0" />

        <TreeView Grid.Row="1" ItemsSource="{Binding BomTree}" Margin="0,10,0,0">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Quantity, StringFormat=' ({0})'}" Margin="5,0,0,0" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="BOM 등록" Command="{Binding AddBomCommand}" Padding="10" Margin="5" />
            <Button Content="BOM 수정" Command="{Binding EditBomCommand}" Padding="10" Margin="5" />
            <Button Content="BOM 삭제" Command="{Binding DeleteBomCommand}" Padding="10" Margin="5" />
        </StackPanel>
    </Grid>
</UserControl>