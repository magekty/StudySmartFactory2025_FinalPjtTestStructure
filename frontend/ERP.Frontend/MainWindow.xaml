<Window x:Class="ERP.Frontend.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ERP.Frontend.Views"
        xmlns:viewmodels="clr-namespace:ERP.Frontend.ViewModels"
        mc:Ignorable="d"
        Title="ERP System" Height="720" Width="1280">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="메뉴" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />
                <Button Content="BOM 관리" Command="{Binding ShowBomViewCommand}" Style="{StaticResource NavButton}" />
                <Button Content="생산 계획" Command="{Binding ShowProductionPlanViewCommand}" Style="{StaticResource NavButton}" />
                <Button Content="원가 계산" Command="{Binding ShowCostViewCommand}" Style="{StaticResource NavButton}" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10" />
    </Grid>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#BBBBBB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>
</Window>